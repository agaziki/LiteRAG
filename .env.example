# DeepSeek API Key（必填，获取地址：https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 话题边界策略：strict=温和模式（无关话题礼貌拒答并引导回业务，推荐企业客服）
#               open=开放模式（通用问题照答，业务事实检索优先、兜底转人工）
# 未设置时默认 strict；也可在管理后台「系统设置」中即时切换（环境变量显式设置时重启后以 .env 为准）
# TOPIC_BOUNDARY=strict

# 管理后台访问密码（强烈建议公网部署时设置；未配置则管理后台与知识库管理 API 整体禁用）
# ADMIN_PASSWORD=your-admin-password

# 可选：自定义 Base URL（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 服务器端口（默认 3000）
PORT=3000

# 长对话管理：发送给模型的滑动窗口大小（最近 N 条消息全量发送，
# 更早历史自动由模型压缩为摘要注入；默认 30）
# HISTORY_WINDOW=30

# ---- 可选：语义检索（不配置则 FAQ/文档使用纯关键词检索）----
# 推荐：硅基流动 SiliconFlow 的 BGE-M3（中文效果好，注册即送免费额度）
#   1. https://cloud.siliconflow.cn 注册并创建 API 密钥
#   2. 按下方示例填写三个变量
# EMBEDDING_API_KEY=sk-your-siliconflow-key
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# 其他 OpenAI 兼容 /embeddings 服务同样可用，例如：
#   火山引擎 Ark:
#     EMBEDDING_API_KEY=your-ark-key
#     EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#     EMBEDDING_MODEL=doubao-embedding-large-text-250515
#   OpenAI:
#     EMBEDDING_API_KEY=sk-xxx
#     EMBEDDING_BASE_URL=https://api.openai.com/v1
#     EMBEDDING_MODEL=text-embedding-3-small
# 配置后可用自检脚本验证连通性：npm run embed:check
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=

# ---- 可选：Rerank 精排（两阶段检索第二阶段，提升命中率）----
# 兼容 SiliconFlow 等 /rerank 接口；不配置则跳过精排
# RERANK_API_KEY=sk-your-siliconflow-key
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- 可选：Token 成本折算（每百万 token 单价，用于后台成本估算）----
# PRICE_INPUT_PER_1M=2
# PRICE_OUTPUT_PER_1M=8

# ---- 可选：内容审核钩子开关（server/moderation.ts 中接入审核服务）----
# IMAGE_MODERATION=true

# ---- 可选：知识库文件自定义路径（默认 server/faq-data.json）----
# FAQ_DATA_PATH=D:/kb/faq-data.json

# ---- 可选：数据库文件自定义路径（默认 data/chat.db）----
# DB_PATH=D:/kb/chat.db

# ---- 可选：历史图片回传（视觉模型「再看刚才那张图」）----
# 开启后回传最近 K 条带图用户消息的图片给视觉模型（成本略增）
# VISION_HISTORY_IMAGES=true
# VISION_HISTORY_IMAGES_COUNT=2

# ---- 可选：外部渠道桥接（企微/公众号等 webhook 网关对接）----
# 配置后开放 POST /api/channels/:channel/message；网关须携带 X-Channel-Secret 头
# 接入指南与网关示例见 docs/CHANNELS.md 与 examples/channel-gateway-demo.js
# CHANNEL_SECRET=your-shared-secret

# ---- 用户注册管控（默认开放注册）----
# 设为 false 关闭注册（只能用已有账号）
# ALLOW_REGISTER=false
# 配置后注册必须携带此邀请码
# REGISTER_INVITE_CODE=your-invite-code
