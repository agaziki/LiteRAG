# DeepSeek API Key（必填，获取地址：https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 可选：自定义 Base URL（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 服务器端口（默认 3000）
PORT=3000

# ---- 可选：语义检索（不配置则 FAQ/文档使用纯关键词检索）----
# 推荐：硅基流动 SiliconFlow 的 BGE-M3（中文效果好，注册即送免费额度）
#   1. https://cloud.siliconflow.cn 注册并创建 API 密钥
#   2. 按下方示例填写三个变量
# EMBEDDING_API_KEY=sk-your-siliconflow-key
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# 其他 OpenAI 兼容 /embeddings 服务同样可用，例如：
#   火山引擎 Ark:
#     EMBEDDING_API_KEY=your-ark-key
#     EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#     EMBEDDING_MODEL=doubao-embedding-large-text-250515
#   OpenAI:
#     EMBEDDING_API_KEY=sk-xxx
#     EMBEDDING_BASE_URL=https://api.openai.com/v1
#     EMBEDDING_MODEL=text-embedding-3-small
# 配置后可用自检脚本验证连通性：npm run embed:check
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=

# ---- 可选：知识库文件自定义路径（默认 server/faq-data.json）----
# FAQ_DATA_PATH=D:/kb/faq-data.json

# ---- 可选：数据库文件自定义路径（默认 data/chat.db）----
# DB_PATH=D:/kb/chat.db
